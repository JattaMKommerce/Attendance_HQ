# JMK HRMS - Backend Environment Configuration

# Server Environment
PORT=5001
NODE_ENV=production

# Database Configuration (MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_strong_db_password
DB_NAME=hrms_saas
DB_CONNECTION_LIMIT=20
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# JWT Authentication Secrets (Generate 64+ char random strings in production)
JWT_SECRET=generate_a_cryptographically_secure_random_string_for_access_tokens
JWT_REFRESH_SECRET=generate_a_cryptographically_secure_random_string_for_refresh_tokens

# CORS Whitelist (comma-separated list of allowed web/mobile origins in production)
# NOTE: Mobile WebView containers (https://localhost, capacitor://localhost) are automatically allowed by backend CORS.
CORS_ORIGIN=https://hrms.jattamkommerce.com,https://admin.jattamkommerce.com,https://localhost,capacitor://localhost

# Application URLs (used in activation links, password resets, and emails)
APP_URL=https://hrms.jattamkommerce.com
APP_DOWNLOAD_URL=https://hrms.jattamkommerce.com/download

# Dedicated HR SMTP Configuration (hr@jattamkommerce.com)
# Option A: cPanel SMTP / Webmail
SMTP_HOST=mail.jattamkommerce.com
SMTP_PORT=465
SMTP_USER=hr@jattamkommerce.com
SMTP_PASS=your-cpanel-email-password
SMTP_FROM="Jatta M Kommerce HR" <hr@jattamkommerce.com>

# Option B: Gmail Relay (if using Google Workspace for jattamkommerce.com)
# GMAIL_USER=hr@jattamkommerce.com
# GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# AI Command Center Configuration
# Supported AI_PROVIDER values: groq (recommended, ultra-fast), gemini, openai, smart_nlu (default local)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

