# JMK HRMS - Backend Environment Configuration

# Server Environment
PORT=5001
NODE_ENV=production

# Database Configuration (MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_strong_db_password
DB_NAME=hrms_saas
DB_CONNECTION_LIMIT=20
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# JWT Authentication Secrets (Generate 64+ char random strings in production)
JWT_SECRET=generate_a_cryptographically_secure_random_string_for_access_tokens
JWT_REFRESH_SECRET=generate_a_cryptographically_secure_random_string_for_refresh_tokens

# CORS Whitelist (comma-separated list of allowed web/mobile origins in production)
# NOTE: Do not include http://localhost in production; localhost is automatically permitted in development (NODE_ENV=development)
CORS_ORIGIN=https://hrms.jattamkommerce.com,https://admin.jattamkommerce.com,capacitor://localhost

# Application URLs (used in activation links, password resets, and emails)
APP_URL=https://hrms.jattamkommerce.com
APP_DOWNLOAD_URL=https://hrms.jattamkommerce.com/download

# Gmail SMTP Configuration for Automated Onboarding & Notification Emails
# 1. Enable 2-Step Verification in Google Account
# 2. Generate 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# AI Command Center Configuration
# Supported AI_PROVIDER values: smart_nlu (default local deterministic NLU), gemini, openai
AI_PROVIDER=smart_nlu
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
